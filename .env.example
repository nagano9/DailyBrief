# =============================================================================
# daily-brief — environment configuration
# =============================================================================
# Copy this file to .env.local and edit. .env.local is gitignored, so your
# keys never leave the machine. Leave everything commented to get the
# default behaviour (claude-cli backend, Max subscription billing).

# -----------------------------------------------------------------------------
# LLM backend selector  (default: claude-cli)
# -----------------------------------------------------------------------------
# claude-cli   — spawn local `claude` binary, billed against Max subscription
# anthropic    — Anthropic Messages API, billed per token
# openai       — OpenAI Chat Completions, billed per token
# deepseek     — DeepSeek (OpenAI-compatible), billed per token
# minimax      — MiniMax (OpenAI-compatible), billed per token
# zhipu        — Zhipu AI / 智谱 (Anthropic-compatible), billed per token
# LLM_BACKEND=claude-cli

# Universal model override. If set, applies to whatever backend is active.
# Otherwise each backend uses a sensible default (see below).
# LLM_MODEL=

# Universal API-key & base-URL aliases. The provider-specific env vars below
# (OPENAI_API_KEY / ANTHROPIC_BASE_URL / ...) win when set; these are the
# fallback for pointing at an OpenAI/Anthropic-compatible service that
# isn't one of the named presets — Moonshot, SiliconFlow, OpenRouter,
# self-hosted vLLM, etc. With these you don't have to misuse OPENAI_API_KEY
# just because you're calling a non-OpenAI service.
# LLM_API_KEY=
# LLM_BASE_URL=

# -----------------------------------------------------------------------------
# Backend: claude-cli  (default; uses your local Claude Code login)
# -----------------------------------------------------------------------------
# CLAUDE_CLI_PATH=          # auto-detected from %APPDATA%\npm\claude.cmd or $PATH
# CLAUDE_MODEL=sonnet       # `sonnet` / `opus` / `haiku` etc — passed to --model

# -----------------------------------------------------------------------------
# Backend: anthropic  (Anthropic API key)
# -----------------------------------------------------------------------------
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_BASE_URL=       # optional; for self-hosted proxies
# LLM_MODEL=claude-sonnet-4-6     # default if not set

# -----------------------------------------------------------------------------
# Backend: openai
# -----------------------------------------------------------------------------
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=          # default: https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini     # default if not set

# -----------------------------------------------------------------------------
# Backend: deepseek  (OpenAI-compatible)
# -----------------------------------------------------------------------------
# DEEPSEEK_API_KEY=sk-...
# DEEPSEEK_BASE_URL=        # default: https://api.deepseek.com/v1
# LLM_MODEL=deepseek-v4-flash     # default if not set
#                                  # Note: legacy `deepseek-chat` alias is
#                                  # being retired 2026-07-24, avoid it.

# -----------------------------------------------------------------------------
# Backend: minimax  (OpenAI-compatible)
# -----------------------------------------------------------------------------
# MINIMAX_API_KEY=...
# MINIMAX_BASE_URL=         # default: https://api.minimax.io/v1
#                           # China mainland: https://api.minimaxi.com/v1
# LLM_MODEL=MiniMax-M2.7    # default if not set

# -----------------------------------------------------------------------------
# Backend: zhipu  (Zhipu AI / 智谱 Coding Plan, Anthropic-compatible)
# -----------------------------------------------------------------------------
# ZHIPU_API_KEY=...
# ZHIPU_BASE_URL=           # default: https://open.bigmodel.cn/api/anthropic
# LLM_MODEL=claude-sonnet-4-6  # default if not set

# =============================================================================
# Report locale (zh = Chinese, en = English). Default zh.
# =============================================================================
# Switches the full pipeline to the target language:
#   - Source set:    sources.config.json filtered by each source's `locales`
#                    (zh-only V2EX/LinuxDo dropped in en mode, en-only HN/Reddit
#                    picked up — run `npm run sources` to inspect)
#   - LLM prompts:   enrichment + digest + trading commentary all use en prompts
#   - UI:            tab labels / dates / footer / trading widgets all localized
#   - Community tab: zh mode uses V2EX/LinuxDo; en mode uses HN/r/stocks
#
# REPORT_LOCALE=zh

# =============================================================================
# Report timezone (IANA name)
# =============================================================================
# Used for date-keyed filenames (daily_reports/<YYYY-MM-DD>/) and for the
# date labels rendered in the HTML. Defaults to the system local timezone.
# Set this if you want the report's "today" to follow a specific city, e.g.
# you run a server in UTC but read reports in Shanghai time.
#
# Examples: Asia/Shanghai · UTC · America/Los_Angeles · Europe/Berlin
# REPORT_TZ=Asia/Shanghai

# =============================================================================
# Output formats
# =============================================================================
# `daily_reports/<date>/<date>.html` is always written (the deliverable).
# `<date>.json` + `<date>-articles.json` are always written too (functional
# caches needed by `npm run render` / `regen-trading` / `regen-enrich`).
#
# Markdown export is OFF by default — it's a pure archive copy, no script reads
# it. Set this to "true" if you want a plain-text snapshot for grep/archive.
#
# OUTPUT_MARKDOWN=true

# =============================================================================
# Optional: auto-deploy to your own server (after each successful daily run)
# =============================================================================
# If both DEPLOY_HOST and DEPLOY_PATH are set, run-daily.mjs scp+ssh's the
# fresh <date>.html into DEPLOY_PATH and refreshes index.html. The server
# user must have sudo NOPASSWD because the doc root is owned by www-data.
# Leave unset to skip deployment (default).
#
# DEPLOY_HOST=ubuntu@1.2.3.4
# DEPLOY_PATH=/var/www/daily.example.com

# ─────────────────────────────────────────────────────────────────────────────
# Strategic Intelligence Radar (lib/brief, lib/site)
# ─────────────────────────────────────────────────────────────────────────────

# Which language editions to compose. Comma-separated, "id" and/or "en".
# Defaults to "id" alone: publishing both from day one doubles model spend and
# editorial surface, and splits SEO attention, for a product with no readers.
# BRIEF_LANGS=id

# How many candidates to put in front of the model. Raising this costs tokens
# and dilutes the pool with lower-tier publishers; lowering it risks missing
# the day's real story.
# BRIEF_CANDIDATE_LIMIT=110

# Refuse to publish below this many validated signals. The target is five; the
# floor exists so a bad model run degrades into a visible failure rather than a
# thin briefing under your masthead.
# BRIEF_MIN_SIGNALS=3

# Hard per-source deadline. A scheduled job that can hang forever is a job that
# silently stops publishing.
# BRIEF_SOURCE_TIMEOUT_MS=25000

# Recompose from .cache/<date>-items.json instead of refetching.
# BRIEF_REUSE_CACHE=true

# Write the model's raw response to .cache/<date>-<lang>-raw.txt. Set this
# before re-running a failed composition — otherwise you pay for another call
# with nothing to inspect.
# BRIEF_DEBUG_RAW=true

# ── Tier 6: signal memory ───────────────────────────────────────────────────

# Tier 6 derives its memory from editions/ — there is no separate signal
# store to configure or keep in step.

# Lookback for trend classification, in days.
# TREND_WINDOW_DAYS=30

# Appearances within the window before a theme is called structural rather
# than merely recurring.
# TREND_STRUCTURAL_MIN=4

# ── Personal relevance layer ────────────────────────────────────────────────

# Reader profile injected into the prompt so implications are translated
# toward what this reader can act on. Copy profile.example.json to
# profile.json (gitignored) and edit. Absent, the brief still runs but without
# the personal-relevance layer, and says so.
# BRIEF_PROFILE=profile.json

# ── Site build (scripts/site.ts) ────────────────────────────────────────────

# Absolute origin, no trailing slash. Used for canonical, OG, hreflang, and
# sitemap URLs. Leaving it unset publishes localhost URLs into your metadata.
# SITE_URL=https://radar.example.com

# Sub-path when not hosted at the origin root, e.g. a GitHub Pages project
# site. Omit for a custom domain.
# BASE_PATH=/DailyBrief

# Custom domain. Set this as a repository VARIABLE (not here) so each deploy
# rewrites the CNAME file — the published branch is replaced wholesale every
# morning, and the domain binding lives inside it. With a custom domain,
# BASE_PATH must be empty.
# CUSTOM_DOMAIN=brief.example.com

# SITE_NAME=Daily Strategic Briefing

# POST target for the subscribe form. Empty renders the form as "opening
# shortly" rather than a form that silently drops addresses.
# SUBSCRIBE_ENDPOINT=

# Privacy policy URL. REQUIRED alongside SUBSCRIBE_ENDPOINT — without it the
# form is withheld entirely. Collecting an address needs a stated purpose and
# a policy to point at; UU PDP treats consent as a precondition.
# PRIVACY_URL=/privasi/

# Social preview image, absolute or root-relative. Deliberately configuration
# rather than generated: most platforms do not render SVG here, so a generated
# vector would silently produce a broken card.
# OG_IMAGE=/og.png

# Override the editions/site directories — used by scripts/brief-selftest.ts
# to render a fixture archive without touching the real one.
# EDITIONS_DIR=editions
# SITE_OUT=site
