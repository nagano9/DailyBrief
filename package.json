{
  "name": "daily-brief",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "test": "npm run typecheck && npm run test:unit && npm run test:integration && npm run test:site",
    "typecheck": "tsc --noEmit",
    "test:unit": "tsx --test test/*.test.ts",
    "test:integration": "tsx scripts/brief-selftest.ts --offline",
    "check:site": "tsx scripts/check-site.ts",
    "brief": "tsx scripts/brief.ts",
    "brief:dry-run": "tsx scripts/brief-dry-run.ts",
    "brief:selftest": "tsx scripts/brief-selftest.ts",
    "site": "tsx scripts/site.ts",
    "dry-run": "tsx scripts/dry-run.ts",
    "daily": "tsx scripts/daily.ts",
    "render": "tsx scripts/render.ts",
    "regen-trading": "tsx scripts/regen-trading.ts",
    "regen-enrich": "tsx scripts/regen-enrich.ts",
    "quota-report": "tsx scripts/quota-report.ts",
    "sources": "tsx scripts/sources.ts",
    "sources:check": "tsx scripts/sources.ts check",
    "deploy": "node scripts/deploy.mjs",
    "build-site": "node scripts/build-site.mjs",
    "open": "node scripts/open-report.mjs",
    "test:site": "tsx scripts/site.ts --editions .cache/selftest/editions --out .cache/test-site --site-url https://example.invalid && tsx scripts/check-site.ts .cache/test-site"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.96.0",
    "cheerio": "^1.2.0",
    "jsonrepair": "^3.14.0",
    "openai": "^6.38.0",
    "rss-parser": "^3.13.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "dotenv": "^17.4.2",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
